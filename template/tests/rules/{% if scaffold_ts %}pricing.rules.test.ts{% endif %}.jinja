// 决策表测试：预期值来自 pricing.csv（由人确认），这里只负责逐行执行。
import { readFileSync } from 'node:fs'
import { describe, expect, it } from 'vitest'
import { totalCents, type Tier } from '@{{ project_slug }}/core'

interface Row {
  tier: Tier
  subtotal: number
  coupon: number
  expected: number
  note: string
}

const rows: Row[] = readFileSync(new URL('./pricing.csv', import.meta.url), 'utf8')
  .trim()
  .split(/\r?\n/)
  .slice(1)
  .map((line) => {
    const [tier, subtotal, coupon, expected, note] = line.split(',')
    return {
      tier: tier as Tier,
      subtotal: Number(subtotal),
      coupon: Number(coupon),
      expected: Number(expected),
      note: note ?? '',
    }
  })

describe('计价决策表', () => {
  it.each(rows)('$tier / 小计 $subtotal / 券 $coupon → $expected（$note）', (row) => {
    const lines = [{ unitPriceCents: row.subtotal, quantity: 1 }]
    expect(totalCents({ tier: row.tier, lines, couponCents: row.coupon })).toBe(row.expected)
  })
})
